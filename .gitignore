.venv/
__pycache__/
*.pyc
# Every fixture is generated by a script in backend/tests/, so none of it is
# committed. That also covers step 6's signed PDFs - and the signing key behind
# them is generated in memory on each run and never written to disk at all, so
# there is no key file here to ignore in the first place.
backend/tests/fixtures/
.pytest_cache/
.env

# Step 5 runtime state. The seeded issuer registry under data/demo/ is
# committed deliberately: it is deterministic, and a fresh checkout should
# work without running the seed script first.
data/store/
*.db
*.db-journal
*.db-wal

