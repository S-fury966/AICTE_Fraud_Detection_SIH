.venv/
__pycache__/
*.pyc
# Every fixture is generated by a script in backend/tests/, so none of it is
# committed. That also covers step 6's signed PDFs - and the signing key behind
# them is generated in memory on each run and never written to disk at all, so
# there is no key file here to ignore in the first place.
backend/tests/fixtures/
.pytest_cache/
.env

# Step 5 runtime state. The seeded issuer registry under data/demo/ is
# committed deliberately: it is deterministic, and a fresh checkout should
# work without running the seed script first.
data/store/
*.db
*.db-journal
*.db-wal

# Step 7 evaluation output: generated documents, manifest, labels, the
# evaluation issuer registry, results and the LLM response cache. All of it is
# reproducible from config/eval_generation.yaml and the seed, so only the
# generator code and the two config files are committed.
data/eval/

# Demo dataset binaries (python -m demo.generate). The mock AICTE records,
# website snapshots and labels are small, deterministic and committed so the
# faculty detector works on a fresh checkout; the certificates and photos are
# regenerated in about a second.
data/demo/applications/
data/demo/evaluation.json
data/demo/logs/

# Frontend build output.
frontend/dist/
